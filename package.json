{
    "name": "assistanthub",
    "version": "1.0.0",
    "homepage": "https://leo0331.github.io/AssistantHub/",
    "private": true,
    "dependencies": {
        "@faker-js/faker": "^10.6.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "leaflet": "^1.9.4",
        "react": "^18.3.1",
        "react-chatbot-kit": "^2.2.2",
        "react-copy-to-clipboard": "^5.1.0",
        "react-csv": "^2.2.2",
        "react-dom": "^18.3.1",
        "react-leaflet": "^4.2.1",
        "react-qr-code": "^2.2.0",
        "web-vitals": "^6.2.3"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "test": "jest --runInBand",
        "lint": "eslint \"src/**/*.{js,jsx}\" vite.config.mjs scripts/tooling.smoke.mjs",
        "test:coverage": "jest --runInBand --coverage",
        "test:ci": "jest --runInBand --coverage --watchAll=false",
        "preview": "vite preview",
        "test:tooling": "node --test scripts/tooling.smoke.mjs",
        "test:release": "node --test scripts/release-guard.check.mjs scripts/workflow-policy.check.mjs && node scripts/release-guard.mjs build",
        "test:react-stack": "node --test scripts/verify-react-stack.check.mjs && node scripts/verify-react-stack.mjs"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@babel/preset-env": "^7.29.14",
        "@babel/preset-react": "^7.29.7",
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "babel-jest": "^30.5.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.14.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.5.2",
        "vite": "^8.3.8",
        "@vitejs/plugin-react": "^6.3.0",
        "jest-environment-jsdom": "^30.5.2"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
