# Local development only: copy to api/.env and adapt to Docker Compose.
# Never commit real database passwords. GitHub Actions supplies test-only values.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=assistanthub
DB_USER=assistanthub
DB_PASSWORD=local_dev_only_change_me
API_HOST=127.0.0.1
API_PORT=3100
# Exact origin of the separate Vite development server (no wildcard, no credentials)
API_CORS_ORIGIN=http://127.0.0.1:3000
# REQUIRED: generate a unique random >= 32-byte JWT secret; do not commit its value.
# AUTH_JWT_SECRET=<set-in-private-environment>
# Admin creation is an operator-only, once-per-user command (never preset demo credentials).
# BOOTSTRAP_USER_EMAIL=<email>
# BOOTSTRAP_USER_PASSWORD=<minimum-12-characters>
# BOOTSTRAP_USER_ROLE=admin
